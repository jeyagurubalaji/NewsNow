# Server
SERVER_PORT=8080

# MongoDB
MONGODB_URI=mongodb://localhost:27017/newsnow

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=replace-with-a-long-random-256-bit-secret
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# News provider - newsdata.io (get a free key at https://newsdata.io)
NEWSDATA_API_KEY=
NEWS_FALLBACK_ENABLED=false
GNEWS_API_KEY=

# Scheduler
SCHEDULER_ENABLED=true
NEWS_REFRESH_CRON=0 */30 * * * *
SCHEDULER_BATCH_SIZE=15

# CORS - comma separated frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional AI summary microservice (Python/FastAPI)
AI_SUMMARY_ENABLED=false
AI_SUMMARY_URL=http://localhost:8000

# Breaking-news heuristic window (minutes) - see BreakingNewsDetector
BREAKING_WINDOW_MINUTES=45

# Firebase Cloud Messaging - breaking-news push to the React/Flutter clients.
# Download a service account key from Firebase Console > Project Settings > Service Accounts.
FCM_ENABLED=false
FCM_SERVICE_ACCOUNT_PATH=
